# IPGHOST local configuration — copy to .env and adjust.
# NEVER commit .env with real values. See README.md / docs/configuration.md.
#
# cp .env.example .env

# Optional. The default provider (ipwho.is) needs NO key.
# Set only if you switch to a provider that requires one.
IPGHOST_API_KEY=

# HTTP timeout in seconds for provider requests (default: 10).
IPGHOST_TIMEOUT=10

# Local cache TTL in seconds (default: 3600). Set to 0 to disable cache.
IPGHOST_CACHE_TTL=3600

# Set to 1 to force colorless output.
IPGHOST_NO_COLOR=

# Set to 1 for verbose debug logging (never prints secrets).
IPGHOST_DEBUG=
